# Copy to scripts/.server.sandbox.env and fill in: the sandbox's own containers (NOT the live ones).
# Find the names with: ssh root@coolify.iskt.co.uk docker ps
WEB_FILTER=web-<sandbox-coolify-uuid>
DB_FILTER=db-<sandbox-coolify-uuid>
# The database name inside the sandbox's postgres container (default: its POSTGRES_DB)
# SERVER_DB=upstage
# After a database goes into the sandbox these usernames are put in the sandbox group (superusers don't need it)
SANDBOX_USERS=
