# Copy to scripts/.server.env and fill in. Settings for both sites (find container names with: ssh root@coolify.iskt.co.uk docker ps)
# SERVER=root@coolify.iskt.co.uk
# OUT_DIR=backups
# USE_COMPOSE_DB=1
#
# The live site's containers go here, or in scripts/.server.live.env:
WEB_FILTER=web-<coolify-uuid>
DB_FILTER=db-<coolify-uuid>
# SERVER_DB=upstage
#
# The sandbox's containers go in scripts/.server.sandbox.env (see .server.sandbox.env.example): the sandbox never uses these.
