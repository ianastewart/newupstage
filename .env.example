# The variables to set in Coolify (or copy to .env, never committed, to run with docker compose).

# A long random string, e.g.: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# The site's host name(s), comma separated
DJANGO_ALLOWED_HOSTS=upstage.iskt.co.uk
# The site's full address(es), comma separated
DJANGO_CSRF_TRUSTED_ORIGINS=https://upstage.example.com

# Coolify: the connection string of its Postgres resource (Dockerfile build). With docker-compose.yml it is built from the DB_ values below.
DATABASE_URL=

DB_NAME=upstage
DB_USER=upstage
DB_PASSWORD=upstagesurrey

# Email (password reset links); leave EMAIL_HOST blank and they are only printed in the log
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Upstage Theatre <noreply@upstage.example>
